{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCC permanent-pinning input",
  "type": "object",
  "additionalProperties": false,
  "required": ["parents", "tables"],
  "$defs": {
    "bit": {"type": "integer", "enum": [0, 1]},
    "index": {"type": "integer", "minimum": 0},
    "cap": {"type": ["integer", "null"], "minimum": 0}
  },
  "properties": {
    "parents": {
      "type": "array",
      "items": {"type": "array", "items": {"$ref": "#/$defs/index"}}
    },
    "tables": {
      "type": "array",
      "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bit"}}
    },
    "target": {"type": "array", "items": {"$ref": "#/$defs/bit"}},
    "baseline": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/index"}},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "support_mode": {"enum": ["slot", "physical"]},
        "max_component_size": {"$ref": "#/$defs/cap"},
        "max_pins": {"$ref": "#/$defs/cap"},
        "max_work": {"$ref": "#/$defs/cap"}
      }
    }
  },
  "$comment": "The Python constructor additionally checks lengths, parent indices less than n, truth-table length 2**arity, and physical fixed-point validity. The CLI performs these checks without an external schema dependency."
}
